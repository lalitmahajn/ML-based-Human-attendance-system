# =========================
# Python / Flask .gitignore
# =========================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
venv/
env/
.venv/

# Environment variables
*.env
.env.*

# Flask instance folder (stores uploads, etc.)
instance/
*.db
*.sqlite3
db.sqlite3-*
*.sqlite3-shm
*.sqlite3-wal

# PyInstaller
*.manifest
*.spec

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
pip-wheel-metadata/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.pytest_cache/

# Jupyter Notebook
.ipynb_checkpoints

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs
*.log

# Local settings.  Anchored to the repo root ON PURPOSE: an unanchored
# `config.py` also matches app/config.py, which is the application's central
# settings module and must ship. It was silently excluded, so a clone had code
# reading settings.vote_consensus with nothing defining it - the app crashed on
# import and the tuned thresholds never reached a deployment made by git.
/config.py

# OS generated files
.DS_Store
Thumbs.db

# Uploaded media
media/
!media/.gitkeep

# ---- added 2026-08-25: keep the repo to source only -------------------
# Biometric / personal data. The face_id_users export README states it
# "contains personal and biometric data" - it must never enter version control.
face_id_users/
# Any staging copy of it is the same biometric data, and this repository
# is public. A bare `git add .` must not be able to reach one.
face_id_users_tmp/
face_id_users_*/
# ...and any archive of it. A zip of the export is the export.
face_id_users*.zip
face_id_users*.tar*

# The research package the ReID work came from. It is kept in the working tree
# because app/config.py cites its measurements by filename, and it is NOT
# committed because `integration/docs/KOZ_TEKSHIRUVI.md` is a visual-inspection
# report that names employees beside physical descriptions of them - "white
# shirt, dark trousers, same build and hairline" - which is personal data about
# identifiable people derived from surveillance, in a public repository.
#
# Nothing in it is needed to run or deploy: the model that is needed ships as
# models/reid_osnet_x0_75_256x128_e512_fp16.onnx, and docs/REID_INTEGRATION.md
# carries every number this deployment relies on. Move it out of band (the
# phd/dissertatsiya2 tree it came from) rather than committing a redacted copy.
integration/

# The SAME DATA IN VECTOR FORM. `bench/validate_gallery.py` writes a cache of
# every enrolment embedding - 268 x 512 floats over 54 named people, with the
# source paths (and therefore the names) stored alongside. A face embedding is
# biometric data; caching it under bench/ does not make it a build artefact.
# Five of these were staged for the first public push and caught by an audit.
bench/*.npz

# Model weights. Tracked out of band by default, restored from models/README or
# the training runs they were exported from.
#
# `models/*` rather than `models/`: git cannot re-include a file whose PARENT
# DIRECTORY is excluded, so an ignored directory would make the exception below
# impossible. Everything inside stays ignored; the exception is listed at the
# very end of this section, because the last matching rule wins.
models/*
*.onnx
*.pt

# Runtime output: clips, debug captures, snapshots, logs, the SQLite db.
data/
staticfiles/
db.sqlite3
*.sqlite3
db.sqlite3-*
*.sqlite3-shm
*.sqlite3-wal

# Local caches
.pytest_cache/

# Licensing: the private key mints licences for ANY machine - never commit it.
vendor_private_key.pem
licence.key
*.onnx.enc

# --- never publish: licence + key material ----------------------------------
# The licence carries the key material the model vault derives its AES key
# from, so committing one hands over the ability to decrypt the shipped
# weights - the exact thing the encryption exists to prevent. `licence.key`
# was already covered; the per-site names from docs/DEPLOY_AISCAN.md were not,
# and a routine `git add -A` after following that guide would have published
# one. Match any licence key, anywhere.
*.key
licence*.key
license*.key
!**/public*.key

# --- the one model that IS published ----------------------------------------
# The person-ReID network carries no biometric data and no customer weights: it
# is a body-appearance model trained on public and in-house pedestrian imagery,
# and the deployment needs it on a machine that only ever receives `git pull`.
# Publishing it is what lets the server update without an out-of-band copy.
#
# This is LAST on purpose. `models/*`, `*.onnx` and `*.onnx.enc` above all match
# it, and in gitignore the final matching rule decides.
#
# NOTHING ELSE is exempted. The face recognizer, the aligner, the head detector,
# every `.enc`, every `.pt` and `models/_archive/` stay ignored - those are
# either customer-encrypted or the fp32 masters that exist nowhere else.
#
# The ResNet101 file is exempted as well as the OSNet one it was replaced by,
# and stays exempted for now: a deployment that has not yet pulled the new
# weights still runs it, and un-publishing a model the server is using would
# break the next `git pull` rather than tidy anything. Remove it once every
# host reports the OSNet model in /api/health.
!models/reid_osnet_x0_75_256x128_e512_fp16.onnx
!models/reid_resnet101_ibn_256x128_e2048_fp16.onnx
scripts/vendor_downloads/

