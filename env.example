# ==============================================================================
# EmAtSy Face Recognition Attendance System - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# ==============================================================================
# 1. CORE OPERATIONAL SETTINGS
# ==============================================================================
detector_model="yolov8n-face.onnx"
head_model=""
recognizer_model="adaface_ir50_base.onnx"
reid_model=""
recognition_threshold_override=0.20

timezone="Asia/Kolkata"
live_preview_fps=30

secret_key="generate-a-secure-random-secret-key"
replay_dir="data/recordings"


# ==============================================================================
# 2. SERVER & NETWORK
# ==============================================================================
#host="0.0.0.0"
#port=8000
#trusted_hosts=""
#url_prefix=""


# ==============================================================================
# 3. STORAGE & PATHS
# ==============================================================================
#root="."
#models_dir="models"
#data_dir="data"
#media_dir="media"
#gallery_dir="face_id_users"
#persons_dir="data/persons"
#debug_dir="data/debug"
#database_url="sqlite+aiosqlite:///data/ematsy.db"
#database_url_sync="sqlite:///data/ematsy.db"


# ==============================================================================
# 4. NEURAL DETECTION & FACE ALIGNMENT
# ==============================================================================
#detector_kind="yolo"
#detect_width=960
#detect_conf=0.35
#aligner_model="dfa_mobilenet_aligner.onnx"
#align_crop_size=160
#align_margin=1.3
#align_mode="sharp"
#embed_batch=8
#gpu_mem_limit_mb=0


# ==============================================================================
# 5. FACE QUALITY & POSE FILTERS
# ==============================================================================
#min_face_px=56
#min_laplacian_var=25.0
#min_aligner_score=0.9
#max_yaw_deg=45.0
#max_pitch_deg=40.0


# ==============================================================================
# 6. HEAD / BODY DETECTION & BYTETRACK ASSOCIATION
# ==============================================================================
#head_input=960
#head_conf=0.35
#track_on="person"
#track_high_thresh=0.5
#track_low_thresh=0.2
#track_match_thresh=0.8
#track_frame_rate=20
#track_buffer=36
#track_max_age_s=3.0


# ==============================================================================
# 7. RECOGNITION, SIMILARITY & TEMPORAL VOTING
# ==============================================================================
#recognition_threshold=0.18
#second_best_margin=0.045
#vote_window=5
#vote_required=3
#vote_consensus=0.65
#vote_min_recognitions=5
#augment_live_floor=0.35
#augment_threshold_margin=0.02
#augment_max_threshold=0.6
#recognizer_thresholds='{"adaface_ir101_finetune_fp16.onnx": 0.215, "adaface_ir101_finetune.onnx": 0.215}'


# ==============================================================================
# 8. PERSON RE-IDENTIFICATION (REID) & CROSS-CAMERA TRACKING
# ==============================================================================
#body_crop_interval_s=1.0
#body_crop_max_per_pass=30
#body_crop_keep_per_pass=10
#body_crop_width=320
#reid_match_threshold=0.6769
#reid_match_margin=0.05
#reid_min_crops=2
#reid_retention_days=30
#reid_match_face_tiebreak=True


# ==============================================================================
# 9. TRACKLET-LEVEL SECOND CHANCE RECOGNITION
# ==============================================================================
#tracklet_face_threshold=0.3
#tracklet_face_margin=0.05
#tracklet_min_face_frames=2


# ==============================================================================
# 10. PSEUDO-GALLERY (AUTOMATIC TEMPLATE MINING)
# ==============================================================================
#pseudo_person=True
#pseudo_face_threshold=0.35
#pseudo_body_threshold=0.75
#pseudo_body_margin=0.05
#pseudo_face_ipd_min=20.0
#pseudo_templates_k=5
#pseudo_body_same_day_only=True
#pseudo_active_days=30


# ==============================================================================
# 11. CAMERA RTSP INGESTION & PIPELINE QUEUE
# ==============================================================================
#rtsp_transport="tcp"
#process_every_nth=1
#stale_after_s=5.0
#replay_max_gap_s=8.0
#frame_queue_size=4


# ==============================================================================
# 12. ATTENDANCE RULES & EVENT LOGIC
# ==============================================================================
#event_cooldown_s=90
#cross_camera_window_s=15.0
#day_boundary_hour=4
#open_interval_policy="flag"
#eod_sweep_enabled=True
#eod_sweep_offset_min=10
#snapshot_retention_days=90


# ==============================================================================
# 13. DEBUG & VIDEO RECORDING
# ==============================================================================
#debug_capture=True
#debug_capture_unknown=True
#debug_max_per_person=40
#record_clips=False
#record_width=1920
#record_pre_roll_s=2.0
#record_post_roll_s=2.0
#record_max_clip_s=60.0
#record_min_free_gb=10.0
#save_all_frames=False
#debug_trace_tracks=False
#debug_trace_limit=10
#save_all_min_free_gb=8.0
